APP_NAME=AI Detective
DATABASE_URL=sqlite:///./ai_detective.db
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
YOLO_MODEL=yolov8m.pt
FRAME_SAMPLE_FPS=3
QWEN_MODEL=Qwen/Qwen3-VL-2B-Instruct
QWEN_ENABLED=true
QWEN_MAX_FRAMES_PER_TRACK=1
QWEN_MIN_CONFIDENCE=0.70
QWEN_MIN_CROP_PIXELS=96
QWEN_MAX_TRACKS=0
QWEN_INCLUDE_CONTEXT=false
QWEN_MAX_NEW_TOKENS=96
# Optional open-source PP-Human/PaddleDetection person-attribute model.  See README.
PPHUMAN_ENABLED=false
PPHUMAN_MODEL_DIR=storage/models/pphuman-person-attribute
PPHUMAN_THRESHOLD=0.55
ATTRIBUTE_COLOR_ENABLED=true
ACTION_MODEL=VideoMAE-Large
ACTION_MODEL_PATH=storage/models/videomae-large-finetuned-kinetics
ACTION_WINDOW_FRAMES=16
ACTION_STRIDE=8
DEVICE=auto
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
UPLOAD_DIR=storage/uploads
FRAME_DIR=storage/frames
CROP_DIR=storage/crops
RESULT_DIR=storage/results
MAX_UPLOAD_MB=1024
